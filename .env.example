# Copy this file to .env (npm install does this automatically if .env is missing).
# No secrets are stored here - only local configuration.

# Web app server (npm run app)
HOST=127.0.0.1
PORT=3000

# URL the UI tests open (must match HOST/PORT above)
BASE_URL=http://127.0.0.1:3000

# Base URL for the public mock API used by the API tests
API_BASE_URL=https://jsonplaceholder.typicode.com

# Browser options for the Cucumber UI tests
HEADLESS=true
SLOW_MO=0
