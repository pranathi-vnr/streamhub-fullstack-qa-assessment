{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "api-tests/**/*.ts", "playwright.config.ts", "playwright.selfhealing.config.ts"],
  "exclude": ["node_modules"]
}
